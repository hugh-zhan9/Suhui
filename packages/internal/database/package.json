{
  "name": "@suhui/database",
  "type": "module",
  "private": true,
  "author": "Folo Team",
  "license": "AGPL-3.0-only",
  "homepage": "https://github.com/hugh-zhan9",
  "repository": {
    "url": "https://github.com/hugh-zhan9/FreeFoloRss",
    "type": "git"
  },
  "sideEffects": false,
  "exports": {
    "./*": {
      "types": "./src/*.ts",
      "require": "./src/*.ts",
      "import": "./src/*.ts"
    },
    "./db.main": {
      "types": "./src/db.main.ts",
      "require": "./src/db.main.ts",
      "import": "./src/db.main.ts"
    },
    "./schemas/*": {
      "types": "./src/schemas/*.ts",
      "require": "./src/schemas/*.ts",
      "import": "./src/schemas/*.ts"
    },
    "./services/*": {
      "types": "./src/services/*.ts",
      "require": "./src/services/*.ts",
      "import": "./src/services/*.ts"
    }
  },
  "scripts": {
    "test": "vitest",
    "generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@follow-app/client-sdk": "catalog:",
    "@suhui/constants": "workspace:*",
    "@suhui/models": "workspace:*",
    "@suhui/shared": "workspace:*",
    "ai": "6.0.85",
    "better-sqlite3": "12.6.2",
    "drizzle-orm": "0.45.1",
    "pg": "8.13.3",
    "wa-sqlite": "git+https://github.com/rhashimoto/wa-sqlite.git#v1.0.8"
  },
  "devDependencies": {
    "@suhui/configs": "workspace:*",
    "@types/pg": "8.10.9",
    "drizzle-kit": "0.31.9"
  }
}
